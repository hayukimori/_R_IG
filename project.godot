; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="<R>IG"
run/main_scene="uid://bjofi1c2jdw8p"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
config/api_host="http://localhost:3000"
config/ws_host="ws://localhost:8080"

[autoload]

AppConfig="*res://autoloads/AppConfig.gd"
GlobalValidations="*res://autoloads/models/GlobalValidations.gd"
Routes="*res://autoloads/Routes.gd"
CurrentUserSession="*res://autoloads/CurrentUserSession.gd"
SceneRouter="*res://autoloads/SceneRouter.gd"
GeneralTools="*res://autoloads/GeneralTools.gd"
GlobalCluster="*res://autoloads/GlobalCluster.gd"
RigSoundLib="*res://autoloads/RIGSoundLib.gd"
SceneHandler="*res://autoloads/SceneHandler.gd"
Announcements="*res://autoloads/Announcements.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/TextureRectRounded/plugin.cfg")

[global_group]

cubes=""

[network]

tls/certificate_bundle_override="res://certificates/ca-bundle.crt"

[rendering]

anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
