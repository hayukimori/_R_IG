; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="<R>IG"
config/version="v1.0.0-alpha.2"
run/main_scene="uid://bjofi1c2jdw8p"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"
config/api_host="http://localhost:3000"
config/ws_host="ws://localhost:8080"

[autoload]

AppConfig="*res://autoloads/AppConfig.gd"
Repositories="*res://autoloads/Repositories.gd"
Services="*res://autoloads/Services.gd"
Models="*res://autoloads/Models.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/TextureRectRounded/plugin.cfg")

[global_group]

cubes=""

[network]

tls/certificate_bundle_override="res://certificates/ca-bundle.crt"

[rendering]

anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
